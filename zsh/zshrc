# configure zsh completion and include dotfiles
autoload -U compinit; compinit
_comp_options+=(globdots)

# load spaceship prompt
export SPACESHIP_CONFIG="$ZDOTDIR/spaceship-config.zsh"
source "$ZDOTDIR/spaceship/spaceship.zsh"

bindkey "^[b" backward-word
bindkey "^[f" forward-word

# add go binaries to path
export PATH="$PATH:$HOME/go/bin:$HOME/go/godev/bin"

# asdf shims (elixir, erlang, etc.) - asdf 0.16+ requires shims on PATH manually
export PATH="$HOME/.asdf/shims:$PATH"

# add config for claude
export AWS_PROFILE=claude
export AWS_REGION=us-east-1
export CLAUDE_CODE_USE_BEDROCK=1
export CLAUDE_CODE_ENABLE_AUTO_MODE=1

# start ssh agent
eval $(ssh-agent -s)


# start ssh agent: prefer 1Password on macOS, otherwise fall back to ssh-agent
_op_sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
if [ -S "$_op_sock" ]; then
  export SSH_AUTH_SOCK="$_op_sock"
elif [ -z "$SSH_AUTH_SOCK" ] || ! ps -p "$SSH_AGENT_PID" >/dev/null 2>&1; then
  eval "$(ssh-agent -s)" >/dev/null
fi
unset _op_sock

export PATH="$HOME/.local/bin:$PATH"
